{
  "name": "moods-style-react-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean-dist": "node -e \"const fs=require('fs');if(fs.existsSync('dist/images')){fs.rmSync('dist/images',{recursive:true});console.log('Removed dist/images (saved ~317 MB)');}\"",
    "predeploy": "npm run build && npm run clean-dist",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "firebase": "^12.12.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  }
}
